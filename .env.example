# ==============================================================================
# Aura Skincare Voice AI Support Agent — Environment Variables
# ==============================================================================
# NOTE: Do NOT commit any real API keys or secrets to git.
# Copy this file to .env.local for local development.
# ==============================================================================

# Server-Side OpenAI API Key
# Used strictly in Next.js API route handlers (/api/session and /api/summary).
# This key is NEVER exposed to client-side browser bundles.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Application Port (default: 3000)
PORT=3000
